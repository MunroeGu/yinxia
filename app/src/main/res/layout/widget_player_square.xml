<?xml version="1.0" encoding="utf-8"?>
<!--
  接近正方形的插件用竖排：封面 / 歌名 / 歌手 / 一排等宽按钮。
  封面是**固定正方形**（56dp），上下各放一个可伸缩的 View 吸收多余高度 ——
  这样封面永远不会被拉成长方形（之前用 weight 撑高封面，方图被裁成竖条，看起来像被拉长）。
  注意 RemoteViews 不允许 android.widget.Space，所以占位用普通 View。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_cover_placeholder" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_idle"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_previous"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/widget_icon" />

        <ImageButton
            android:id="@+id/widget_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_play"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="@color/widget_icon" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_next"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/widget_icon" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
